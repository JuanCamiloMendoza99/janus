# Copy to `.env` and fill in. `.env` is git-ignored — never commit real keys.

# --- Service ---------------------------------------------------------------
APP_NAME=janus
# local | ci | production. Only affects logging defaults and the health payload.
ENVIRONMENT=local

# --- Provider selection ----------------------------------------------------
# THE switch this project is built around: change this line, restart, and every
# endpoint is served by a different vendor. No code changes, no redeploy of
# anything but config.
#   anthropic | openai | fake
# `fake` needs no credentials and makes no network calls — it is how the test
# suite and CI run.
LLM_PROVIDER=fake

# --- Credentials -----------------------------------------------------------
# Only the key for the selected provider is required. The registry checks at
# startup and fails with a clear message rather than letting a vendor 401
# surface on the first request.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Models ----------------------------------------------------------------
# Kept separate from LLM_PROVIDER so the cost/quality tier can be changed
# without touching the provider seam. Defaults are each vendor's mid tier;
# the pricing table also carries the flagship/small siblings
# (claude-opus-4-8, gpt-5.6-sol, gpt-5.6-luna) so you can re-point either of
# these without a code change. Model ids + rates verified 2026-07-20.
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-5.6-terra

# --- Generation ------------------------------------------------------------
MAX_OUTPUT_TOKENS=4096
REQUEST_TIMEOUT_SECONDS=120

# --- Prompt caching --------------------------------------------------------
# Sends the support playbook as a cacheable prefix. Worth knowing: Anthropic
# silently declines to cache prefixes below a per-model floor (~4096 tokens on
# Opus 4.8) — no error, it just never hits. Confirm it is working via
# `cache_hit_rate` on GET /v1/usage, not by the fact that this is `true`.
PROMPT_CACHING_ENABLED=true

# --- Cost controls ---------------------------------------------------------
# Hard ceiling per request in USD; a request projected above it is rejected
# rather than silently truncated. Set to 0 to disable.
MAX_COST_USD_PER_REQUEST=0.50

# --- Observability ---------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# json for aggregators, text for tailing locally.
LOG_FORMAT=json
